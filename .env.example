# ==============================================================================
# AGRI-ECONOMIC INTELLIGENCE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual API keys.
# DO NOT COMMIT REAL KEYS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM PROVIDER (Required for multimodal crop disease & voice assistant)
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. SATELLITE & REMOTE SENSING (Copernicus Data Space Ecosystem - CDSE)
# ------------------------------------------------------------------------------
# Required for Sentinel-1 SAR radar flood inundation mapping.
# Register for free at: https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=your_copernicus_client_id_here
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret_here

# ------------------------------------------------------------------------------
# 3. SPEECH PROCESSING (faster-whisper)
# ------------------------------------------------------------------------------
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ------------------------------------------------------------------------------
# 4. DATASET & RUNTIME STORAGE PATHS (Defaults point to local repository)
# ------------------------------------------------------------------------------
# In production container or VPS, set to mounted volume if applicable
SOIL_DB_PATH=ml/data/water/soil-nutrients.db
RESERVOIR_KML_PATH=ml/data/water/reservoir.kml
VOICE_DATA_DIR=voice_data

# ------------------------------------------------------------------------------
# 5. FRONTEND PRODUCTION BASE URLS (Used during Vite build on Vercel)
# In production with unified server, all point to your public backend URL.
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=https://your-agri-backend.hf.space
VITE_VOICE_API_BASE_URL=https://your-agri-backend.hf.space
VITE_CROP_HEALTH_API_BASE_URL=https://your-agri-backend.hf.space
VITE_PRODUCTION_API_BASE_URL=https://your-agri-backend.hf.space

# ------------------------------------------------------------------------------
# 6. BACKEND CORS ALLOWED ORIGINS (Comma-separated)
# ------------------------------------------------------------------------------
AGRI_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://agri-ai.vercel.app

